{
  "name": "trasir",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/setup-test-db.mjs && vitest run",
    "test:pg": "node -e \"process.env.TEST_DATABASE_URL=process.env.TEST_DATABASE_URL||'postgresql://trasir_test:trasir_test_password@127.0.0.1:5433/trasir_test'; require('node:child_process').execSync('npm test', { stdio: 'inherit', env: process.env });\"",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:use-postgres": "node scripts/switch-db-provider.mjs postgresql",
    "db:use-sqlite": "node scripts/switch-db-provider.mjs sqlite",
    "routes:count": "node scripts/count-api-routes.mjs",
    "routes:check": "node scripts/count-api-routes.mjs --check-readme",
    "db:backfill-tahap5": "node scripts/backfill-tahap5.mjs",
    "db:migrate-receipts": "node scripts/migrate-receipts-to-blob.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@phosphor-icons/react": "^2.1.7",
    "@prisma/client": "^6.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "jose": "^6.0.10",
    "lucide-react": "^1.77.0",
    "next": "15.5.29",
    "nodemailer": "^10.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^5.1.2"
  }
}
