generator client {
  provider = "prisma-client-js"
}

// Default provider is "sqlite" for instant zero-config local database execution;
// Run `npm run db:use-postgres` after setting Supabase PostgreSQL `DATABASE_URL` in `.env`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Room {
  id                   String    @id @default(cuid())
  name                 String
  address              String    @default("Indonesia")
  toleranceThresholdRp Int       @default(50000)
  opnameSchedule       String    @default("MINGGUAN") // HARIAN | MINGGUAN | BULANAN
  openAreaPolicy       String    @default("Evaluasi faktor eksternal (pelanggan/kerusakan fisik) sebelum tindak lanjut internal.")
  closedAreaPolicy     String    @default("Evaluasi ketat berbasis log akses pegawai, bukti foto, dan kronologi shift.")
  // @deprecated Gunakan tabel BackupLog untuk status backup nyata (tidak dihapus demi kompatibilitas)
  autoBackupInterval   String    @default("HARIAN") // HARIAN | MINGGUAN | NONAKTIF
  lastBackupAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users                User[]
  categories           Category[]
  warehouses           Warehouse[]
  products             Product[]
  productRequests      ProductRequest[]
  purchases            Purchase[]
  sales                Sale[]
  saleAmendments       SaleAmendment[]
  shiftClosings        ShiftClosing[]
  stockAdjustments     StockAdjustment[]
  opnameSessions       StockOpnameSession[]
  invitations          StoreInvitation[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  backupLogs           BackupLog[]
  counters             Counter[]
  shifts               Shift[]
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("KASIR") // PEMILIK | MANAJER | KASIR | GUDANG | KASIR_GUDANG
  isActive     Boolean   @default(true)
  isAssigned   Boolean   @default(true)
  roomId             String?
  room               Room?     @relation(fields: [roomId], references: [id])
  tokenVersion       Int       @default(1)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchasesSubmitted       Purchase[]           @relation("PurchaseSubmitter")
  purchasesReviewed        Purchase[]           @relation("PurchaseReviewer")
  salesCashier             Sale[]               @relation("SaleCashier")
  amendmentsReq            SaleAmendment[]      @relation("AmendmentRequester")
  amendmentsRev            SaleAmendment[]      @relation("AmendmentReviewer")
  shiftClosings            ShiftClosing[]       @relation("ShiftCashier")
  shifts                   Shift[]              @relation("ShiftUser")
  adjustmentsReq           StockAdjustment[]    @relation("AdjustmentRequester")
  adjustmentsRev           StockAdjustment[]    @relation("AdjustmentReviewer")
  opnamesCreated           StockOpnameSession[] @relation("OpnameCreator")
  opnamesReviewed          StockOpnameSession[] @relation("OpnameReviewer")
  invitationsReceived      StoreInvitation[]    @relation("InvitationTarget")
  invitationsSent          StoreInvitation[]    @relation("InvitationSender")
  productRequestsSubmitted ProductRequest[]     @relation("ProductRequestSubmitter")
  productRequestsReviewed  ProductRequest[]     @relation("ProductRequestReviewer")
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@index([roomId, isAssigned])
  @@index([roomId, role, isActive])
}

model StoreInvitation {
  id             String    @id @default(cuid())
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  storeName      String    @default("TRASIR Toko Utama")
  code           String?   @unique
  targetUserId   String?
  targetUser     User?     @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUsername String?
  invitedById    String
  invitedBy      User      @relation("InvitationSender", fields: [invitedById], references: [id])
  assignedRole   String    // MANAJER | KASIR | GUDANG | KASIR_GUDANG
  status         String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | REVOKED | EXPIRED
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([targetUserId, status])
  @@index([roomId, status, createdAt])
  @@index([status, createdAt])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       String   // PEMILIK | MANAJER | KASIR | GUDANG | KASIR_GUDANG
  module     String   // dashboard | kasir | penjualan | pembelian | produk | inventaris | laporan | aktivitas | pengaturan
  canView    Boolean  @default(false)
  canCreate  Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canApprove Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([role, module])
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique // kg, g, mg, ton, liter, ml, meter, cm, pcs, dus, pak, botol, bungkus, sachet, butir, ikat, renteng, lusin, kotak, kemasan, karung
  label     String
  group     String   // BERAT | VOLUME | PANJANG | HITUNGAN
  createdAt DateTime @default(now())
}

model Category {
  id              String           @id @default(cuid())
  roomId          String
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name            String
  areaType        String           @default("TERBUKA") // TERBUKA | TERTUTUP
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  products        Product[]
  productRequests ProductRequest[]

  @@unique([roomId, name])
  @@index([roomId])
}

model Warehouse {
  id          String               @id @default(cuid())
  roomId      String
  room        Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name        String
  location    String?
  isDefault   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  stocks      ProductStock[]
  fromAdjusts StockAdjustment[]    @relation("FromWarehouse")
  toAdjusts   StockAdjustment[]    @relation("ToWarehouse")
  opnames     StockOpnameSession[]

  @@unique([roomId, name])
  @@index([roomId])
}

model Product {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sku             String
  barcode         String?
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  stockMethod     String   @default("TETAP") // TETAP | PECAH | RESEP
  isRawMaterial   Boolean  @default(false)
  purchaseUnit    String   @default("pcs")
  sellUnit        String   @default("pcs")
  conversionRatio Float    @default(1) // 1 purchaseUnit = conversionRatio sellUnit
  costPrice       Int      @default(0) // HPP per sellUnit in Rupiah (integer)
  sellPrice       Int      @default(0) // Harga jual default in Rupiah (integer)
  currentStock    Float    @default(0) // Stok dalam sellUnit
  minStockAlert   Float    @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants         ProductVariant[]
  usedInRecipes    RecipeIngredient[] @relation("IngredientMaterial")
  warehouseStocks  ProductStock[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  opnameItems      StockOpnameItem[]

  @@unique([roomId, sku])
  @@unique([roomId, barcode])
  @@index([roomId, isActive])
}

model ProductRequest {
  id                String    @id @default(cuid())
  roomId            String
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requestedById     String
  requestedBy       User      @relation("ProductRequestSubmitter", fields: [requestedById], references: [id])
  reviewedById      String?
  reviewedBy        User?     @relation("ProductRequestReviewer", fields: [reviewedById], references: [id])
  status            String    @default("MENUNGGU_PERSETUJUAN") // MENUNGGU_PERSETUJUAN | DISETUJUI | DITOLAK
  rejectionReason   String?
  sku               String
  barcode           String?
  name              String
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  stockMethod       String    @default("TETAP") // TETAP | PECAH | RESEP
  isRawMaterial     Boolean   @default(false)
  purchaseUnit      String    @default("pcs")
  sellUnit          String    @default("pcs")
  conversionRatio   Float     @default(1)
  costPrice         Int       @default(0)
  sellPrice         Int       @default(0)
  minStockAlert     Float     @default(5)
  variantsJson      String?
  approvedProductId String?
  createdAt         DateTime  @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([roomId, status, createdAt])
  @@index([requestedById, createdAt])
}

model ProductVariant {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String             // e.g. Regular, Large
  sellPrice   Int                // Harga jual varian dalam Rupiah
  costPrice   Int                @default(0) // Estimasi HPP varian berdasarkan resep
  ingredients RecipeIngredient[]
  saleItems   SaleItem[]

  @@unique([productId, name])
}

model RecipeIngredient {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  materialId String
  material   Product        @relation("IngredientMaterial", fields: [materialId], references: [id])
  quantity   Float          // Takaran bahan baku dalam sellUnit material
  unit       String         // Label satuan takaran

  @@unique([variantId, materialId])
}

model ProductStock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model Purchase {
  id                  String         @id @default(cuid())
  roomId              String
  room                Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invoiceNumber       String
  supplierName        String
  purchaseDate        DateTime
  fundingSource       String         @default("DANA_TOKO") // DANA_TOKO | BELANJA_PEMILIK
  captureMethod       String         @default("LIVE_CAMERA") // LIVE_CAMERA | DIGITAL_UPLOAD
  /// @deprecated Gunakan receiptUrl (object storage) setelah migrasi foto nota selesai.
  receiptImageData    String         // Base64 / Data URL bukti nota (legacy / pre-migration)
  receiptUrl          String?        // URL object storage (Vercel Blob) bukti nota
  receiptHash         String?        // Hash untuk mendeteksi unggahan file nota ganda
  totalAmount         Int            // Total nilai pembelian yang diinput pegawai (Rupiah)
  aiValidationStatus  String         @default("PENDING") // PENDING | SESUAI | ADA_SELISIH | NOTA_GANDA | TERINDIKASI_EDIT
  aiExtractedSupplier String?
  aiExtractedDate     String?
  aiExtractedTotal    Int?
  aiAnalysisJson      String?        // JSON hasil pembacaan Gemini AI
  approvalStatus      String         @default("MENUNGGU_PERSETUJUAN") // MENUNGGU_PERSETUJUAN | PERLU_PERBAIKAN | DISETUJUI | DITOLAK
  ownerNotes          String?
  submittedById       String
  submittedBy         User           @relation("PurchaseSubmitter", fields: [submittedById], references: [id])
  reviewedById        String?
  reviewedBy          User?          @relation("PurchaseReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items               PurchaseItem[]

  @@index([roomId, approvalStatus, createdAt])
  @@index([roomId, createdAt, id])
  @@index([roomId, purchaseDate])
}

model PurchaseItem {
  id                String   @id @default(cuid())
  purchaseId        String
  purchase          Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])
  isNewProduct      Boolean  @default(false)
  itemName          String
  categoryName      String?
  quantity          Float
  unit              String
  conversionRatio   Float    @default(1) // Rasio ke satuan jual
  sellUnit          String   @default("pcs")
  unitCost          Int      // Harga beli per satuan beli (Rupiah)
  sellPrice         Int      @default(0)
  subtotal          Int      // Total harga baris (Rupiah)
  aiExtractedQty    Float?
  aiExtractedPrice  Int?
  aiDiscrepancyNote String?
}

model Sale {
  id             String          @id @default(cuid())
  roomId         String
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  receiptNumber  String          @unique
  cashierId      String
  cashier        User            @relation("SaleCashier", fields: [cashierId], references: [id])
  shiftId        String?
  shift          Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  counterId      String?
  counter        Counter?        @relation(fields: [counterId], references: [id], onDelete: SetNull)
  paymentMethod  String          @default("TUNAI") // TUNAI | QRIS | TRANSFER | KARTU
  discountAmount Int             @default(0) // Diskon transaksi (Rupiah)
  totalAmount    Int             // Total penjualan bersih setelah diskon (Rupiah)
  totalCost      Int             // Total HPP barang terjual (Rupiah) untuk rumus Laba Kotor
  cashReceived   Int             @default(0)
  changeAmount   Int             @default(0)
  status         String          @default("NORMAL") // NORMAL | MENUNGGU_PERSETUJUAN | DIBATALKAN | DIKEMBALIKAN | DIUBAH
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          SaleItem[]
  amendments     SaleAmendment[]

  @@index([roomId, createdAt])
  @@index([roomId, createdAt, id])
  @@index([roomId, status, createdAt])
  @@index([roomId, cashierId, createdAt])
  @@index([shiftId])
  @@index([counterId])
}

model SaleItem {
  id          String          @id @default(cuid())
  saleId      String
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  quantity    Float
  unitPrice   Int
  unitCost    Int             // HPP per unit saat transaksi terjadi (snapshot historis)
  subtotal    Int
  totalCost   Int
}

model SaleAmendment {
  id              String    @id @default(cuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  saleId          String
  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amendmentType   String    // PEMBATALAN | RETUR | PERUBAHAN
  reason          String
  proofImageData  String?
  proofMimeType   String?
  proposedPayload String?   // JSON rincian perubahan jika tipe PERUBAHAN
  status          String    @default("MENUNGGU_PERSETUJUAN") // MENUNGGU_PERSETUJUAN | DISETUJUI | DITOLAK
  requestedById   String
  requestedBy     User      @relation("AmendmentRequester", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?     @relation("AmendmentReviewer", fields: [reviewedById], references: [id])
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([roomId, status, createdAt])
  @@index([saleId, status])
}

// @deprecated Dipertahankan untuk kompatibilitas historis (tidak dihapus). Gunakan model Shift sungguhan.
model ShiftClosing {
  id                  String   @id @default(cuid())
  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cashierId           String
  cashier             User     @relation("ShiftCashier", fields: [cashierId], references: [id])
  shiftDate           DateTime @default(now())
  systemTxCount       Int
  systemCashTotal     Int
  systemQrisTotal     Int
  systemTransferTotal Int
  systemCardTotal     Int
  systemGrandTotal    Int
  actualCashTotal     Int
  actualDigitalTotal  Int
  cashDifference      Int      @default(0) // Dipertahankan untuk kompatibilitas data historis
  digitalDifference   Int      @default(0) // Dipertahankan untuk kompatibilitas data historis
  totalDifference     Int      @default(0) // Dipertahankan untuk kompatibilitas data historis
  status              String   @default("TERCATAT") // TERCATAT | SESUAI | PERLU_DIPERIKSA (historis)
  notes               String?
  createdAt           DateTime @default(now())

  @@index([roomId, createdAt])
}

model Counter {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts    Shift[]
  sales     Sale[]

  @@unique([roomId, slug])
  @@index([roomId, isActive])
}

model Shift {
  id                       String    @id @default(cuid())
  roomId                   String
  room                     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User      @relation("ShiftUser", fields: [userId], references: [id])
  counterId                String?
  counter                  Counter?  @relation(fields: [counterId], references: [id], onDelete: SetNull)
  counterSlug              String    @default("loket-1")
  counterName              String    @default("Loket 1")
  openedAt                 DateTime  @default(now())
  closedAt                 DateTime?
  status                   String    @default("AKTIF") // AKTIF | SESUAI | DALAM_TOLERANSI | PERLU_DIPERIKSA | TERCATAT
  openingCashTotal         Int       @default(0)
  closingCashTotal         Int?
  actualDigitalTotal       Int       @default(0)
  operationalExpenseTotal  Int       @default(0)
  expectedCashAtClose      Int?
  cashDifference           Int       @default(0)
  systemTxCount            Int       @default(0)
  systemCashTotal          Int       @default(0)
  systemQrisTotal          Int       @default(0)
  systemTransferTotal      Int       @default(0)
  systemCardTotal          Int       @default(0)
  systemGrandTotal         Int       @default(0)
  openingDenominationsJson String?
  closingDenominationsJson String?
  operationalExpensesJson  String?
  openingNote              String?
  closingNote              String?
  previousShiftId          String?
  previousShiftClosingCash Int?
  handoverSyncStatus       String    @default("SHIFT_PERTAMA")
  handoverDifference       Int       @default(0)
  legacyShiftClosingId     String?   @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  sales                    Sale[]

  @@index([roomId, status, openedAt])
  @@index([roomId, userId, status])
  @@index([roomId, counterId, status])
}

model StockAdjustment {
  id              String     @id @default(cuid())
  roomId          String
  room            Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  adjustmentType  String     // RUSAK | KEDALUWARSA | HILANG | DIKEMBALIKAN | PINDAH_GUDANG
  quantity        Float      // Jumlah dalam satuan jual
  reason          String
  proofImageData  String?
  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  status          String     @default("MENUNGGU_PERSETUJUAN") // MENUNGGU_PERSETUJUAN | DISETUJUI | DITOLAK
  requestedById   String
  requestedBy     User       @relation("AdjustmentRequester", fields: [requestedById], references: [id])
  reviewedById    String?
  reviewedBy      User?      @relation("AdjustmentReviewer", fields: [reviewedById], references: [id])
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([roomId, status, createdAt])
}

model StockOpnameSession {
  id                 String            @id @default(cuid())
  roomId             String
  room               Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title              String
  scheduleType       String            @default("MINGGUAN") // HARIAN | MINGGUAN | BULANAN | INSIDENTAL
  warehouseId        String?
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  toleranceThreshold Int               @default(50000)
  status             String            @default("SUBMITTED") // OPEN | SUBMITTED | EVALUATED
  createdById        String
  createdBy          User              @relation("OpnameCreator", fields: [createdById], references: [id])
  reviewedById       String?
  reviewedBy         User?             @relation("OpnameReviewer", fields: [reviewedById], references: [id])
  createdAt          DateTime          @default(now())
  submittedAt        DateTime?
  evaluatedAt        DateTime?

  items              StockOpnameItem[]

  @@index([roomId, createdAt])
}

model StockOpnameItem {
  id                  String             @id @default(cuid())
  sessionId           String
  session             StockOpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  areaType            String             // TERBUKA | TERTUTUP
  systemStock         Float
  physicalStock       Float
  differenceUnit      Float              // physicalStock - systemStock
  unitCost            Int
  lossValueRp         Int                // abs(differenceUnit * unitCost)
  exceedsTolerance    Boolean            @default(false)
  toleranceStatus     String             @default("AMAN") // SESUAI | DALAM_TOLERANSI | ANOMALI_TERBUKA | ANOMALI_TERTUTUP
  employeeExplanation String?
  proofImageData      String?
  ownerDecision       String             @default("BELUM_DIEVALUASI") // BELUM_DIEVALUASI | TERIMA_PENJELASAN | MINTA_INFO_TAMBAHAN | TANDAI_TINDAK_LANJUT
  ownerNotes          String?
  updatedAt           DateTime           @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  title      String
  message    String
  severity   String   @default("INFO") // INFO | WARNING | CRITICAL
  category   String   // PEMBELIAN | PENJUALAN | STOK_OPNAME | PERUBAHAN_STOK | SHIFT | SISTEM | KATALOG
  targetRole String?  // Jika null maka untuk PEMILIK & MANAJER ruangan, atau spesifik userId
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  linkUrl    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roomId, isRead, createdAt])
  @@index([userId, isRead])
}

model AuditLog {
  id            String   @id @default(cuid())
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id])
  actorName     String
  actorRole     String
  actionType    String
  actionSummary String
  entityType    String
  entityId      String?
  beforeData    String?
  afterData     String?
  approvalState String?
  linkUrl       String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([roomId, createdAt])
}

model BackupLog {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  triggerType  String   @default("CRON") // CRON | MANUAL
  status       String   // SUCCESS | FAILED
  sizeBytes    Int      @default(0)
  storageUrl   String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([roomId, triggerType, status, createdAt])
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  codeHash    String?
  purpose     String    @default("email-change")
  userId      String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  lockedUntil DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
  @@index([userId, purpose])
}

model SystemSetting {
  id                   String    @id @default("default")
  storeName            String    @default("TRASIR Toko Utama")
  storeAddress         String    @default("Jakarta, Indonesia")
  toleranceThresholdRp Int       @default(50000)
  opnameSchedule       String    @default("MINGGUAN")
  // @deprecated Daftar loket kini disimpan di tabel Counter (kolom dipertahankan untuk kompatibilitas mundur)
  openAreaPolicy       String    @default("Evaluasi faktor eksternal (pelanggan/kerusakan fisik) sebelum tindak lanjut internal.")
  closedAreaPolicy     String    @default("Evaluasi ketat berbasis log akses pegawai, bukti foto, dan kronologi shift.")
  autoBackupInterval   String    @default("HARIAN")
  lastBackupAt         DateTime?
  updatedAt            DateTime  @updatedAt
}
